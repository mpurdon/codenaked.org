---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <img
    class="poster"
    src="/images/poster.webp"
    srcset="/images/poster-640.webp 640w, /images/poster.webp 1024w"
    {/* Download hint ONLY — the rendered size is set in CSS (.poster).
        Deliberately plain lengths: math functions in `sizes` are parsed
        inconsistently across engines, and a wrong guess here costs at worst
        one size step, never a layout change. */}
    sizes="(max-width: 700px) 92vw, 520px"
    width="1024"
    height="1536"
    alt="Coed Naked Coding — a neon 1980s poster of two coders at a beige desktop computer surrounded by pizza, floppy disks and coffee. Tagline: play with your bits, then commit. No protection. Straight to production."
    fetchpriority="high"
    decoding="async"
  />
</Layout>
